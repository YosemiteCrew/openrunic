# openrunic self-host configuration.
#
# Copy this file to .env, or let `pnpm setup:selfhost` write it for you - it
# generates the secrets and never prints them.
#
#   cp .env.example .env
#   pnpm setup:selfhost
#
# Every value here except SESSION_COOKIE_SECRET also has a default inside
# docker-compose.yml, and those defaults are for trying openrunic out on a
# machine you control. That one has no default on purpose, so the stack stops
# with a message naming it rather than starting a deployment where every
# sign-in fails. Before this is reachable from any network, generate real
# secrets: the defaults are published in this repository and are not secret.
#
# This file is read by docker compose. It is in .gitignore. Never commit it.

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
# The value `generate-me` is a sentinel: `pnpm setup:selfhost` replaces it with
# 32 bytes of random data and leaves any real value it finds alone. Generated
# secrets are base64url, so they are always safe inside a connection URL.
POSTGRES_PASSWORD=generate-me

POSTGRES_USER=openrunic
POSTGRES_DB=openrunic

# The role the API connects as, which is deliberately NOT the one above.
#
# POSTGRES_USER owns the schema and is a superuser, because that is what the
# official Postgres image's initdb creates, and a superuser bypasses every
# row-level security policy silently and completely. Those policies are this
# deployment's last line of tenant isolation, so an API connecting as the owner
# would work exactly as well while never once being checked by them.
#
# `ops/postgres/initdb/10-app-role.sh` creates this role on a first run and the
# RLS migration grants it what it needs. `migrate` keeps the owner: it creates
# tables, and this role must not be able to.
#
# Neither has a default in docker-compose.yml: both use the `:?` form, so a
# stack missing them stops with a message naming the variable instead of
# starting on a credential published in this repository. The password carries
# the same `generate-me` sentinel as POSTGRES_PASSWORD above, so
# `pnpm setup:selfhost` fills it on a first run and leaves a real value alone.
OPENRUNIC_DB_APP_USER=openrunic_app
OPENRUNIC_DB_APP_PASSWORD=generate-me

# -----------------------------------------------------------------------------
# Ports published on the host
# -----------------------------------------------------------------------------
# The database port is deliberately absent. Postgres is reachable only from the
# other containers; backup and restore reach it through `docker compose exec`.
WEB_PORT=3000
API_PORT=4000

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
# The key the web application seals its session cookie with. It carries the
# same `generate-me` sentinel as the database password above, so
# `pnpm setup:selfhost` fills it on a first run and leaves a real value alone.
# Unlike everything else here it has no default in docker-compose.yml, and the
# web service now requires it with the `:?` form, so a stack missing this key
# stops with a message naming it instead of starting. That is the point: the
# container runs with NODE_ENV=production, where the code refuses to fall back
# to the development key published in the source, so before the guard existed
# such a stack would build, start, look healthy, and answer 503 to every sign-in.
# Note the guard only catches an ABSENT value. The `generate-me` sentinel below
# is a value, so it passes the guard. Replace it.
SESSION_COOKIE_SECRET=generate-me

# How the browser reaches the API. This is baked into the web image at build
# time, so changing it means `docker compose build web`. Use the address staff
# type into a browser, never the compose service name.
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000

# `live` talks to the API. `mock` serves the application from in-browser
# fixtures with no database at all, which is what the end-to-end drill runs
# against.
NEXT_PUBLIC_API_MODE=live

# The fallback when no identity provider is configured below. `demo-tokens` maps
# a few public tokens, printed in the source, onto demo users, and the API prints
# a warning on every boot while it is in force. It is for a laptop. Configure the
# OIDC settings below and it is replaced by real token verification.
OPENRUNIC_AUTH_MODE=demo-tokens

# ---------------------------------------------------------------------------
# Published FHIR resources
#
# Canonical base for the FHIR resources this deployment publishes. Only
# Questionnaire.url uses it today, and it needs it: a form published without
# this claims a canonical URL on the openrunic project's own domain, which you
# do not run and nobody can resolve to your forms. Set it to your public API
# base if you serve Questionnaires.
#
# Leave it blank if you do not. A blank value here means "not set", not "set to
# nothing", so the stack starts either way.
# ---------------------------------------------------------------------------
OPENRUNIC_FHIR_BASE_URL=

# ---------------------------------------------------------------------------
# Identity provider (OIDC)
#
# openrunic verifies identity, it does not issue it. There are no passwords in
# this system: point it at the directory the clinic already has. Set all of the
# following and the demo tokens above stop being accepted.
#
# The API needs these three to check a token's signature. All three or none:
# a half-set group is refused at startup, because an issuer with no key set
# would otherwise leave the stack on the demo tokens while looking configured.
# Uncomment all three together.
#OIDC_ISSUER=https://id.example.org
#OIDC_AUDIENCE=openrunic-api
#OIDC_JWKS_URI=https://id.example.org/.well-known/jwks.json
#
# Optional. Tolerance on a token's exp, nbf and iat, in seconds. Blank means
# unset, which is the documented default of 60 - not zero.
#OIDC_CLOCK_SKEW_SECONDS=60
#
# The web app needs these two to sign a person in. The redirect URI must be
# registered with the provider exactly as written here, and must be the /auth/
# callback path on the address staff reach openrunic at.
#OIDC_CLIENT_ID=openrunic-web
#OIDC_REDIRECT_URI=https://openrunic.example.org/auth/callback
#
# Optional. The browser flow uses PKCE and needs no secret, but some providers
# still require one for the authorization code grant.
#OIDC_CLIENT_SECRET=
#
# Optional, and only for third-party SMART on FHIR apps. Set both and
# /fhir/.well-known/smart-configuration publishes a launch pointing at your
# provider; leave both unset and the document omits the endpoints, which tells
# an app it cannot launch here rather than sending it somewhere that answers
# nothing. Named rather than discovered because that document is public, and a
# public endpoint that fetches a URL on request is a way to make this API send
# traffic on someone else's behalf.
#OIDC_AUTHORIZATION_ENDPOINT=https://id.example.org/authorize
#OIDC_TOKEN_ENDPOINT=https://id.example.org/oauth/token
#
# Optional. Defaults to `openid profile email`.
#OIDC_SCOPES=openid profile email
# ---------------------------------------------------------------------------

# `if-empty` writes the demo practice into a database with no organisations in
# it, and does nothing otherwise. Set to `never` for a real clinic.
OPENRUNIC_SEED=if-empty

# -----------------------------------------------------------------------------
# Backups
# -----------------------------------------------------------------------------
# Where `pnpm ops:backup` writes. Relative paths are resolved from the
# repository root. Put this on a different disk from the Postgres volume - a
# backup that dies with the machine it protects is not a backup.
OPENRUNIC_BACKUP_DIR=./backups

# Backups older than this are deleted after a successful new one. Never on a
# schedule of their own, so a run of failing backups cannot quietly age out the
# last good copy.
OPENRUNIC_BACKUP_RETAIN_DAYS=30

# -----------------------------------------------------------------------------
# Resource limits
# -----------------------------------------------------------------------------
# Sized for a two-clinician practice on a 4 vCPU / 8 GB box. Postgres gets the
# most memory because it is the only component whose performance depends on
# cache. Raise these before raising the machine.
POSTGRES_CPU_LIMIT=2.0
POSTGRES_MEMORY_LIMIT=2g
POSTGRES_MEMORY_RESERVATION=512m
API_CPU_LIMIT=2.0
API_MEMORY_LIMIT=1g
API_MEMORY_RESERVATION=256m
WEB_CPU_LIMIT=2.0
WEB_MEMORY_LIMIT=1g
WEB_MEMORY_RESERVATION=256m
MIGRATE_MEMORY_LIMIT=1g

# Tag applied to the images this stack builds. Bump it when you want an upgrade
# to be able to roll back to the previous images by tag.
OPENRUNIC_IMAGE_TAG=local
