# openrunic environment template.
# Copy to .env and fill in values for your machine: cp .env.example .env
# NEVER commit .env (it is gitignored). Only this .env.example, with placeholder
# values, belongs in git.

# --- packages/database (Prisma / PostgreSQL) ---
# Pooled connection string used by the application at runtime.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/openrunic?schema=public"
# Direct (non-pooled) connection string used by Prisma Migrate.
DIRECT_URL="postgresql://USER:PASSWORD@localhost:5432/openrunic?schema=public"

# --- apps/api (Hono) ---
PORT=4000
