# Dependencies
node_modules/

# Build output
dist/
build/
.next/
out/
*.tsbuildinfo

# Turbo
.turbo/

# Test coverage
coverage/

# The JSON report the migration workflow reads to prove its DATABASE_URL-gated
# suites actually ran rather than skipped. Written into the workspace by
# `vitest --outputFile`, never committed.
apps/api/vitest-database.json

# Sonar scanner working directory. CI reads report-task.txt out of it (see
# scripts/ci/sonar-thresholds.mjs), and a local scan leaves one behind too.
.scannerwork/

# Environment - never commit secrets
.env
.env.*
!.env.example

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# Editor / OS
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json

# Local tooling output
.tmp/

# Security scan output. CI writes SBOMs and scan reports here and uploads them
# as artifacts; a local run of the same commands should not offer to commit them.
security/sbom/
security/reports/
# Operational data written by the backup tooling. Backups of a real practice
# are the most sensitive thing this repository could ever accidentally carry.
backups/

# Playwright output from the clinical drill
playwright-report/
test-results/

# Prisma 7 generated client (regenerated by prisma generate)
packages/database/src/generated/

# Copied from @openrunic/ui on dev and build (scripts/copy-ui-styles.mjs)
apps/portal/public/styles.css

# React Doctor report, written by `pnpm run doctor:json` and by CI.
react-doctor.json

# The drill's minted session cookie. Not a secret - it seals a fixture identity
# against a mock-mode server - but it is a credential shaped thing with a clock
# in it, and a stale one committed here would fail as a confusing redirect.
apps/e2e/.auth/

# Git worktrees the agent tooling checks out inside the repository.
#
# Not because git would stage their contents - it will not. A linked worktree
# carries its own .git, so `git add -A` warns "adding embedded git repository"
# and writes a single mode-160000 gitlink instead, which is the quieter and
# worse outcome: the commit then points at a worktree that exists on one
# machine, clones do not contain it and cannot fetch it, and the tree looks like
# it has a submodule that nobody declared.
#
# Narrower than `.claude/` on purpose: a team that wants to commit
# `.claude/settings.json` or a shared agent definition still can.
.claude/worktrees/
