# apps/portal configuration. Copy to .env.local for a checkout; set these on the
# build or runtime for a deployment. SESSION_COOKIE_SECRET is server-side secret
# material and must never be exposed through a NEXT_PUBLIC_ variable.

# Where the data comes from. Anything other than `live` means the fixtures in
# `src/lib/api/mock`, which is the default because every screen has to be
# demoable and testable without Postgres behind it.
#
NEXT_PUBLIC_API_MODE=mock

# The API origin reached by the same-origin server proxy in live mode.
OPENRUNIC_API_URL=http://localhost:4000

# Required in production to seal the httpOnly patient session cookie.
# SESSION_COOKIE_SECRET=

# -----------------------------------------------------------------------------
# Hosted Voice (Text-to-Speech)
#
# When configured, the assistant will offer a hosted voice for reading answers
# aloud, in addition to the device's built-in voice. Both are available and the
# reader chooses which to use.
#
# Requires all three variables to be set. An incomplete configuration is ignored.
# -----------------------------------------------------------------------------
# The TTS service endpoint. Must accept POST / with JSON { text, language } and
# return an audio response (audio/mpeg, audio/wav, audio/ogg, etc.).
# NEXT_PUBLIC_HOSTED_VOICE_ENDPOINT=https://tts.example.com/synthesize
#
# The executed agreement covering health data egress to the TTS service.
# Named as the deployer refers to it (e.g. "Google Cloud TTS BAA 2024-Q1").
# NEXT_PUBLIC_HOSTED_VOICE_AGREEMENT=
#
# Comma-separated BCP-47 language tags the configured voice speaks.
# NEXT_PUBLIC_HOSTED_VOICE_LANGUAGES=en-GB,en-US,es-ES
