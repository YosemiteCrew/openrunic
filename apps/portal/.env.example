# apps/portal configuration. Copy to .env.local for a checkout; set these on the
# build or runtime for a deployment. SESSION_COOKIE_SECRET is server-side secret
# material and must never be exposed through a NEXT_PUBLIC_ variable.

# Where the data comes from. Anything other than `live` means the fixtures in
# `src/lib/api/mock`, which is the default because every screen has to be
# demoable and testable without Postgres behind it.
#
NEXT_PUBLIC_API_MODE=mock

# The API origin reached by the same-origin server proxy in live mode.
OPENRUNIC_API_URL=http://localhost:4000

# Required in production to seal the httpOnly patient session cookie.
# SESSION_COOKIE_SECRET=
