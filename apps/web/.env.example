# apps/web configuration. Copy to .env.local for a checkout; set these on the
# build for a deployment. Nothing here is a secret except SESSION_COOKIE_SECRET.

# Where the data comes from. Anything other than `live` means the fixtures in
# `src/lib/api/mock`, which is the default because every screen has to be
# demoable and testable without Postgres behind it.
NEXT_PUBLIC_API_MODE=mock

# The API's address, when NEXT_PUBLIC_API_MODE=live.
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000

# Opens the sign-in door on a production build, for a public demonstration.
# It does nothing unless NEXT_PUBLIC_API_MODE is also mock: the credentials it
# opens are the API's public development fixtures, and a build reading a real
# API refuses them. See docs/demo.md.
# NEXT_PUBLIC_DEMO_MODE=true

# The key the session cookie is sealed with. A production build refuses to sign
# anyone in without it, and answers 503 rather than blaming the credential.
# Generate one per deployment: `openssl rand -base64 32`.
# SESSION_COOKIE_SECRET=

# Where the container health check reaches the API. Used by /api/health only.
# OPENRUNIC_API_INTERNAL_URL=http://api:4000
