{
  "name": "openrunic",
  "version": "0.0.0",
  "private": true,
  "description": "Open-source operating system for human health",
  "license": "AGPL-3.0-only",
  "packageManager": "pnpm@10.30.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prepare": "husky",
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "type-check": "turbo run type-check",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,mjs,cjs,json,md,css,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,mjs,cjs,json,md,css,yml,yaml}\"",
    "check:secrets": "secretlint \"**/*\"",
    "verify": "pnpm run lint && pnpm run type-check && pnpm run test && pnpm run build"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@secretlint/secretlint-rule-no-dotenv": "^11.7.1",
    "@secretlint/secretlint-rule-preset-recommend": "^11.7.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.9.6",
    "secretlint": "^11.7.1",
    "turbo": "^2.10.9",
    "typescript": "^5.9.3"
  }
}
