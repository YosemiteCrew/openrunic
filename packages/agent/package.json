{
  "name": "@openrunic/agent",
  "version": "0.1.0",
  "description": "The openrunic agent loop: approval gating, tenant scoping, budget caps and audit emission over a deployer-configured inference endpoint.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "openrunic-agent-conform": "./dist/conform/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc --build tsconfig.json",
    "lint": "eslint .",
    "type-check": "tsc -p tsconfig.typecheck.json",
    "test": "vitest run",
    "conform": "node dist/conform/cli.js"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.0",
    "@ai-sdk/openai-compatible": "^3.0.0",
    "@openrunic/agent-tools": "workspace:*",
    "ai": "^7.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.1",
    "@vitest/coverage-v8": "^4.1.0",
    "eslint": "^10.8.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.66.0",
    "vitest": "^4.1.0"
  }
}
