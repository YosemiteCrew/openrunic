{
  "name": "@openrunic/database",
  "version": "0.1.0",
  "description": "Prisma schema, migrations, and client factory for Openrunic's Postgres database.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./seed": {
      "types": "./dist/seed/index.d.ts",
      "default": "./dist/seed/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "prisma"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "prisma generate && tsc --build tsconfig.json",
    "lint": "eslint .",
    "type-check": "tsc -p tsconfig.typecheck.json",
    "test": "vitest run",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "node dist/seed/run.js"
  },
  "dependencies": {
    "@prisma/client": "^7.9.1",
    "zod": "^4.4.3",
    "@prisma/adapter-pg": "^7.9.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.1",
    "@types/pg": "^8.15.5",
    "@vitest/coverage-v8": "^4.1.0",
    "eslint": "^9.39.5",
    "pg": "^8.16.3",
    "prisma": "^7.9.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.66.0",
    "vitest": "^4.1.0"
  }
}
