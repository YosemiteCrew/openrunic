generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

/// Append-only audit log. Every security-relevant action in the EMR lands here
/// on day one — who (actor) did what (action) to which record (target), when.
model AuditEvent {
  id         String   @id @default(uuid())
  occurredAt DateTime @default(now())
  actorType  String
  actorId    String
  action     String
  targetType String
  targetId   String?
  metadata   Json?

  @@index([targetType, targetId])
  @@index([occurredAt])
}
