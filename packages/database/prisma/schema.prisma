// ---------------------------------------------------------------------------
// Platform
// ---------------------------------------------------------------------------

/// The tenant root. Every other model hangs off exactly one Organisation via
/// `tenantId`; deleting an Organisation purges the tenant.
model Organisation {
  id        String             @id @db.Uuid
  slug      String             @unique
  name      String
  mode      OrganisationMode   @default(SELF_HOST)
  status    OrganisationStatus @default(ACTIVE)
  timezone  String             @default("UTC")
  /// Per-tenant feature flags; also the canary-rollout switch on SaaS.
  flags     Json               @default("{}")
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  facilities            Facility[]
  users                 User[]
  userFacilities        UserFacility[]
  roles                 Role[]
  permissions           Permission[]
  rolePermissions       RolePermission[]
  roleAssignments       RoleAssignment[]
  patients              Patient[]
  patientIdentifiers    PatientIdentifier[]
  relatedPersons        RelatedPerson[]
  payers                Payer[]
  coverages             Coverage[]
  documents             Document[]
  appointments          Appointment[]
  appointmentHistory    AppointmentStatusHistory[]
  encounters            Encounter[]
  clinicalNotes         ClinicalNote[]
  noteAddenda           NoteAddendum[]
  conditions            Condition[]
  medicationStatements  MedicationStatement[]
  medicationRequests    MedicationRequest[]
  allergies             AllergyIntolerance[]
  immunizations         Immunization[]
  observations          Observation[]
  serviceRequests       ServiceRequest[]
  referrals             Referral[]
  stockItems            StockItem[]
  stockLots             StockLot[]
  stockLotStatusChanges StockLotStatusChange[]
  stockPostings         StockPosting[]
  stockMovements        StockMovement[]
  specimens             Specimen[]
  diagnosticReports     DiagnosticReport[]
  resultObservations    ResultObservation[]
  tasks                 Task[]
  messageThreads        MessageThread[]
  messages              Message[]
  chargeItems           ChargeItem[]
  claims                Claim[]
  claimLines            ClaimLine[]
  claimStatusHistory    ClaimStatusHistory[]
  payments              Payment[]
  paymentAllocations    PaymentAllocation[]
  remittances           Remittance[]
  remittanceLines       RemittanceLine[]
  statements            Statement[]
  formDefinitions       FormDefinition[]
  formSubmissions       FormSubmission[]
  formPromotedValues    FormPromotedValue[]
  terminologyCodes      TerminologyCode[]
  consentGrants         ConsentGrant[]
  auditEvents           AuditEvent[]
  telehealthVisits      TelehealthVisit[]

  valueSets      ValueSet[]
  imagingStudies ImagingStudy[]

  @@index([status])
}

/// A place of service. Unlimited per organisation; scheduling, encounters and
/// charges are all facility-scoped.
model Facility {
  id           String   @id @db.Uuid
  tenantId     String   @db.Uuid
  name         String
  /// Short code used in the UI and on printed documents.
  code         String
  npi          String?
  /// CMS place-of-service code, e.g. "11" for office. Coded, so a string.
  posCode      String?
  timezone     String   @default("UTC")
  addressLine1 String?
  addressLine2 String?
  city         String?
  state        String?
  postalCode   String?
  country      String   @default("US")
  phone        String?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  organisation Organisation @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  userFacilities    UserFacility[]
  patients          Patient[]
  appointments      Appointment[]
  encounters        Encounter[]
  chargeItemsAtSite ChargeItem[]
  stockLots         StockLot[]
  stockPostings     StockPosting[]

  @@unique([tenantId, code])
  @@index([tenantId, active])
}

/// Staff and clinicians. A practitioner is a User with `isProvider = true`;
/// there is no separate Practitioner table, because in an ambulatory practice
/// every clinician is also a system user.
model User {
  id           String     @id @db.Uuid
  tenantId     String     @db.Uuid
  email        String
  givenName    String
  familyName   String
  /// Display credential suffix, e.g. "MD", "NP", "RN". Free text by design.
  credential   String?
  npi          String?
  dea          String?
  /// NUCC provider taxonomy code. Coded, so a string.
  taxonomyCode String?
  isProvider   Boolean    @default(false)
  locale       String     @default("en-US")
  status       UserStatus @default(INVITED)
  lastLoginAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  organisation Organisation @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  facilities         UserFacility[]
  roleAssignments    RoleAssignment[]
  appointments       Appointment[]
  encounters         Encounter[]
  authoredNotes      ClinicalNote[]
  noteAddenda        NoteAddendum[]
  medicationRequests MedicationRequest[]
  serviceRequests    ServiceRequest[]
  referralsMade      Referral[]
  assignedTasks      Task[]
  sentMessages       Message[]
  renderedCharges    ChargeItem[]

  @@unique([tenantId, email])
  @@index([tenantId, isProvider, status])
  @@index([tenantId, familyName, givenName])
}

/// Facility grants. The policy layer intersects these with role permissions.
model UserFacility {
  id         String   @id @db.Uuid
  tenantId   String   @db.Uuid
  userId     String   @db.Uuid
  facilityId String   @db.Uuid
  isPrimary  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  organisation Organisation @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  facility     Facility     @relation(fields: [facilityId], references: [id], onDelete: Cascade)

  @@unique([userId, facilityId])
  @@index([tenantId, facilityId])
}

/// A named bundle of permissions. Seeded system roles are per tenant so a
/// tenant can fork them without affecting anyone else.
model Role {
  id          String   @id @db.Uuid
  tenantId    String   @db.Uuid
  key         String
  name        String
  description String?
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  organisation Organisation @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  permissions RolePermission[]
  assignments RoleAssignment[]

  @@unique([tenantId, key])
}

/// One atomic capability, e.g. `patient.read`, `claim.submit`. The permission
/// catalogue is data, not code, so plugins can register their own.
model Permission {
  id          String   @id @db.Uuid
  tenantId    String   @db.Uuid
  key         String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  organisation Organisation @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  roles RolePermission[]

  @@unique([tenantId, key])
}

model RolePermission {
  id           String   @id @db.Uuid
  tenantId     String   @db.Uuid
  roleId       String   @db.Uuid
  permissionId String   @db.Uuid
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  organisation Organisation @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  role         Role         @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission   @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([tenantId, permissionId])
}

/// Binds a user to a role, optionally narrowed to one facility. A NULL
/// facilityId means organisation-wide. Postgres treats NULLs as distinct in a
/// unique index, so the organisation-wide duplicate check is enforced in the
/// application layer rather than by this constraint.
model RoleAssignment {
  id         String   @id @db.Uuid
  tenantId   String   @db.Uuid
  userId     String   @db.Uuid
  roleId     String   @db.Uuid
  facilityId String?  @db.Uuid
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  organisation Organisation @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role         Role         @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId, facilityId])
  @@index([tenantId, roleId])
}

// ---------------------------------------------------------------------------
// Registration
// ---------------------------------------------------------------------------

/// Slim patient core. Custom demographics live in a FormSubmission bound to the
/// patient, never in extra columns here and never in an EAV table. The primary
/// address and contact points are inline because every screen needs them;
/// address history becomes a satellite table when history is actually built.
model Patient {
  id                 String               @id @db.Uuid
  tenantId           String               @db.Uuid
  /// Human-facing medical record number. Unique per organisation.
  mrn                String
  primaryFacilityId  String?              @db.Uuid
  givenName          String
  middleName         String?
  familyName         String
  prefix             String?
  suffix             String?
  preferredName      String?
  birthDate          DateTime             @db.Date
  deceasedAt         DateTime?
  sexAtBirth         AdministrativeGender @default(UNKNOWN)
  /// Coded gender identity (SNOMED CT / US Core value set), so a string.
  genderIdentityCode String?
  pronouns           String?
  /// OMB race and ethnicity codes; repeating by definition.
  raceCodes          String[]
  ethnicityCodes     String[]
  languageCode       String               @default("en")
  maritalStatusCode  String?
  email              String?
  phoneMobile        String?
  phoneHome          String?
  addressLine1       String?
  addressLine2       String?
  city               String?
  state              String?
  postalCode         String?
  country            String               @default("US")
  sensitivityClass   SensitivityClass     @default(NORMAL)
  portalEnabled      Boolean              @default(false)
  active             Boolean              @default(true)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  organisation    Organisation @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  primaryFacility Facility?    @relation(fields: [primaryFacilityId], references: [id], onDelete: SetNull)

  identifiers          PatientIdentifier[]
  relatedPersons       RelatedPerson[]
  coverages            Coverage[]
  documents            Document[]
  appointments         Appointment[]
  encounters           Encounter[]
  clinicalNotes        ClinicalNote[]
  conditions           Condition[]
  medicationStatements MedicationStatement[]
  medicationRequests   MedicationRequest[]
  allergies            AllergyIntolerance[]
  immunizations        Immunization[]
  observations         Observation[]
  serviceRequests      ServiceRequest[]
  referrals            Referral[]
  specimens            Specimen[]
  diagnosticReports    DiagnosticReport[]
  resultObservations   ResultObservation[]
  tasks                Task[]
  messageThreads       MessageThread[]
  chargeItems          ChargeItem[]
  claims               Claim[]
  payments             Payment[]
  paymentAllocations   PaymentAllocation[]
  statements           Statement[]
  formSubmissions      FormSubmission[]
  formPromotedValues   FormPromotedValue[]
  consentGrants        ConsentGrant[]

  /// Patient search: by MRN (exact), by name, by date of birth. The `active`
  /// prefix keeps the default "search living, non-merged patients" path on one
  /// index.
  stockPostings  StockPosting[]
  imagingStudies ImagingStudy[]

  @@unique([tenantId, mrn])
  @@index([tenantId, familyName, givenName])
  @@index([tenantId, birthDate])
  @@index([tenantId, active, familyName, givenName])
  @@index([tenantId, primaryFacilityId, active])
}

/// Every identifier that is not the MRN: SSN, driving licence, payer member id,
/// an external EHR's patient id after a migration.
model PatientIdentifier {
  id          String        @id @db.Uuid
  tenantId    String        @db.Uuid
  patientId   String        @db.Uuid
  use         IdentifierUse @default(SECONDARY)
  /// Namespace URI, e.g. "http://hl7.org/fhir/sid/us-ssn". Coded, so a string.
  system      String
  value       String
  /// HL7 v2-0203 identifier type code, e.g. "MR", "SS", "DL". Coded.
  typeCode    String?
  assigner    String?
  periodStart DateTime?
  periodEnd   DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  organisation Organisation @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  patient      Patient      @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@unique([tenantId, system, value])
  @@index([tenantId, patientId])
  @@index([tenantId, value])
}

/// FHIR RelatedPerson: guardians, emergency contacts, portal proxies.
model RelatedPerson {
  id                 String   @id @db.Uuid
  tenantId           String   @db.Uuid
  patientId          String   @db.Uuid
  /// HL7 v3 RoleCode relationship, e.g. "MTH", "GUARD". Coded, so a string.
  relationshipCode   String
  relationshipText   String?
  givenName          String
  familyName         String
  phone              String?
  email              String?
  addressLine1       String?
  city               String?
  state              String?
  postalCode         String?
  country            String   @default("US")
  isGuardian         Boolean  @default(false)
  isEmergencyContact Boolean  @default(false)
  isPortalProxy      Boolean  @default(false)
  active             Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  organisation Organisation @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  patient      Patient      @relation(fields: [patientId], references: [id], onDelete: Cascade)

  consentGrants ConsentGrant[]

  @@index([tenantId, patientId, active])
}

/// An insurance company. X12 payer administration lives here.
model Payer {
  id                 String   @id @db.Uuid
  tenantId           String   @db.Uuid
  name               String
  /// Trading-partner payer id used in the 837 NM109. Coded, so a string.
  x12PayerId         String?
  /// 837 SBR09 claim filing indicator, e.g. "MC", "CI". Coded.
  claimFilingCode    String?
  eligibilityPayerId String?
  addressLine1       String?
  city               String?
  state              String?
  postalCode         String?
  country            String   @default("US")
  phone              String?
  active             Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  organisation Organisation @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  coverages   Coverage[]
  claims      Claim[]
  remittances Remittance[]
  payments    Payment[]

  @@unique([tenantId, name])
  @@index([tenantId, active])
}

/// One insurance policy in one coordination-of-benefits slot.
model Coverage {
  id                         String         @id @db.Uuid
  tenantId                   String         @db.Uuid
  patientId                  String         @db.Uuid
  payerId                    String         @db.Uuid
  rank                       CoverageRank   @default(PRIMARY)
  status                     CoverageStatus @default(ACTIVE)
  memberId                   String
  groupNumber                String?
  planName                   String?
  /// Subscriber relationship to the patient, HL7 v3 RoleCode. Coded.
  subscriberRelationshipCode String         @default("self")
  subscriberGivenName        String?
  subscriberFamilyName       String?
  subscriberBirthDate        DateTime?      @db.Date
  effectiveFrom              DateTime?      @db.Date
  effectiveTo                DateTime?      @db.Date
  copayCents                 Int?
  deductibleCents            Int?
  acceptAssignment           Boolean        @default(true)
  createdAt                  DateTime       @default(now())
  updatedAt                  DateTime       @updatedAt

  organisation Organisation @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  patient      Patient      @relation(fields: [patientId], references: [id], onDelete: Cascade)
  payer        Payer        @relation(fields: [payerId], references: [id], onDelete: Restrict)

  claims Claim[]

  @@index([tenantId, patientId, rank])
  @@index([tenantId, payerId, status])
}

/// Any stored binary: uploads, scans, inbound faxes, generated PDFs. Inbound
/// faxes land with status INBOX and are triaged through a Task.
model Document {
  id               String           @id @db.Uuid
  tenantId         String           @db.Uuid
  patientId        String?          @db.Uuid
  encounterId      String?          @db.Uuid
  /// Document category code (LOINC document type where one exists). Coded.
  category         String
  title            String
  /// Object-storage key. Bytes never live in Postgres.
  storageKey       String
  contentType      String
  sha256           String
  byteSize         Int
  source           DocumentSource   @default(UPLOAD)
  status           DocumentStatus   @default(INBOX)
  sensitivityClass SensitivityClass @default(NORMAL)
  receivedAt       DateTime         @default(now())
  filedAt          DateTime?
  filedById        String?          @db.Uuid
  /// The document that replaced this one. Set when status becomes SUPERSEDED,
  /// because a status saying something replaced this is not much use without
  /// saying what.
  supersededById   String?          @db.Uuid
  /// Why this was marked ENTERED_IN_ERROR. Somebody will ask, and the audit
  /// trail records who and when but not what they saw.
  errorReason      String?
  expiresAt        DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  organisation Organisation @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  patient      Patient?     @relation(fields: [patientId], references: [id], onDelete: Restrict)
  encounter    Encounter?   @relation(fields: [encounterId], references: [id], onDelete: Restrict)

  consentGrants ConsentGrant[]

  /// Referrals whose report is this document.
  referralReports Referral[]

  supersededBy Document?  @relation("DocumentSupersedes", fields: [supersededById], references: [id], onDelete: Restrict)
  supersedes   Document[] @relation("DocumentSupersedes")

  @@index([tenantId, patientId, category])
  @@index([tenantId, status, receivedAt])
  @@index([tenantId, encounterId])
  /// Answers "have these exact bytes arrived before", which is what stops a fax
  /// received twice becoming two documents in one chart.
  @@index([tenantId, sha256])
}

// ---------------------------------------------------------------------------
// Scheduling
// ---------------------------------------------------------------------------

/// A booked slot. Appointment types are configuration data carried inline as a
/// code plus display, so renaming a type never rewrites history.
model Appointment {
  id                String                @id @db.Uuid
  tenantId          String                @db.Uuid
  facilityId        String                @db.Uuid
  patientId         String?               @db.Uuid
  providerId        String                @db.Uuid
  /// Appointment type code from the tenant's configured catalogue. Coded.
  typeCode          String
  typeDisplay       String
  status            AppointmentStatus     @default(BOOKED)
  start             DateTime
  end               DateTime
  durationMinutes   Int
  room              String?
  reasonText        String?
  /// Shared by every occurrence generated from one recurrence rule.
  recurrenceGroupId String?               @db.Uuid
  recurrenceRule    Json?
  createdVia        AppointmentCreatedVia @default(STAFF)
  cancelReason      String?
  checkedInAt       DateTime?
  createdById       String?               @db.Uuid
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  organisation Organisation @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  facility     Facility     @relation(fields: [facilityId], references: [id], onDelete: Restrict)
  patient      Patient?     @relation(fields: [patientId], references: [id], onDelete: Restrict)
  provider     User         @relation(fields: [providerId], references: [id], onDelete: Restrict)

  statusHistory   AppointmentStatusHistory[]
  encounter       Encounter?
  telehealthVisit TelehealthVisit?

  /// The schedule day view: one facility, one date range.
  @@index([tenantId, facilityId, start])
  /// The Flow Board: one facility, today, grouped by status.
  @@index([tenantId, facilityId, status, start])
  @@index([tenantId, providerId, start])
  @@index([tenantId, patientId, start])
  @@index([tenantId, recurrenceGroupId])
}

/// Append-only status trail. Flow Board wait timers derive from it, so the
/// board never needs a separate timing table.
model AppointmentStatusHistory {
  id            String            @id @db.Uuid
  tenantId      String            @db.Uuid
  appointmentId String            @db.Uuid
  status        AppointmentStatus
  occurredAt    DateTime          @default(now())
  byUserId      String?           @db.Uuid
  room          String?
  note          String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  organisation Organisation @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  appointment  Appointment  @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@index([tenantId, appointmentId, occurredAt])
  @@index([tenantId, status, occurredAt])
}

// ---------------------------------------------------------------------------
// Clinical
// ---------------------------------------------------------------------------

/// A visit. Created automatically on check-in from the appointment.
model Encounter {
  id            String          @id @db.Uuid
  tenantId      String          @db.Uuid
  facilityId    String          @db.Uuid
  patientId     String          @db.Uuid
  providerId    String          @db.Uuid
  appointmentId String?         @unique @db.Uuid
  class         EncounterClass  @default(AMBULATORY)
  status        EncounterStatus @default(PLANNED)
  /// Chief complaint / visit reason code. Coded, so a string.
  reasonCode    String?
  reasonText    String?
  startedAt     DateTime
  endedAt       DateTime?
  signedAt      DateTime?
  signedById    String?         @db.Uuid
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  organisation Organisation @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  facility     Facility     @relation(fields: [facilityId], references: [id], onDelete: Restrict)
  patient      Patient      @relation(fields: [patientId], references: [id], onDelete: Restrict)
  provider     User         @relation(fields: [providerId], references: [id], onDelete: Restrict)
  appointment  Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)

  documents            Document[]
  clinicalNotes        ClinicalNote[]
  conditions           Condition[]
  medicationStatements MedicationStatement[]
  medicationRequests   MedicationRequest[]
  immunizations        Immunization[]
  observations         Observation[]
  serviceRequests      ServiceRequest[]
  referrals            Referral[]
  diagnosticReports    DiagnosticReport[]
  tasks                Task[]
  chargeItems          ChargeItem[]
  claims               Claim[]
  formSubmissions      FormSubmission[]

  stockPostings  StockPosting[]
  imagingStudies ImagingStudy[]

  @@index([tenantId, patientId, startedAt])
  @@index([tenantId, facilityId, status, startedAt])
  @@index([tenantId, providerId, startedAt])
}

/// A block-structured clinical document. `blocks` is a JSONB block list, not
/// HTML and not a serialized template: it is authored and rendered by the same
/// typed block schema in `@openrunic/types`.
model ClinicalNote {
  id          String    @id @db.Uuid
  tenantId    String    @db.Uuid
  patientId   String    @db.Uuid
  encounterId String    @db.Uuid
  authorId    String    @db.Uuid
  title       String
  blocks      Json      @default("[]")
  state       NoteState @default(DRAFT)
  cosignerId  String?   @db.Uuid
  cosignedAt  DateTime?
  signedAt    DateTime?
  signedById  String?   @db.Uuid
  lockedAt    DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  organisation Organisation @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  patient      Patient      @relation(fields: [patientId], references: [id], onDelete: Restrict)
  encounter    Encounter    @relation(fields: [encounterId], references: [id], onDelete: Restrict)
  author       User         @relation(fields: [authorId], references: [id], onDelete: Restrict)

  addenda NoteAddendum[]

  /// The unsigned-note debt board.
  @@index([tenantId, state, createdAt])
  @@index([tenantId, patientId, createdAt])
  @@index([tenantId, encounterId])
  @@index([tenantId, authorId, state])
}

/// A signed note is immutable. Later corrections are addenda, never edits.
model NoteAddendum {
  id        String    @id @db.Uuid
  tenantId  String    @db.Uuid
  noteId    String    @db.Uuid
  authorId  String    @db.Uuid
  blocks    Json      @default("[]")
  reason    String?
  signedAt  DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  organisation Organisation @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  note         ClinicalNote @relation(fields: [noteId], references: [id], onDelete: Cascade)
  author       User         @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@index([tenantId, noteId, createdAt])
}

/// Problem list entries and encounter diagnoses. `category` splits the typed
/// issue lists (problems, surgeries, dental) without a polymorphic string key.
model Condition {
  id                 String                      @id @db.Uuid
  tenantId           String                      @db.Uuid
  patientId          String                      @db.Uuid
  encounterId        String?                     @db.Uuid
  category           ConditionCategory           @default(PROBLEM_LIST_ITEM)
  /// Primary code, normally ICD-10-CM. Coded, so a string plus its system.
  code               String
  codeSystem         String                      @default("http://hl7.org/fhir/sid/icd-10-cm")
  display            String
  /// Optional SNOMED CT equivalent for interop.
  snomedCode         String?
  clinicalStatus     ConditionClinicalStatus     @default(ACTIVE)
  verificationStatus ConditionVerificationStatus @default(CONFIRMED)
  onsetDate          DateTime?                   @db.Date
  abatementDate      DateTime?                   @db.Date
  severityCode       String?
  bodySiteCode       String?
  note               String?
  recordedAt         DateTime                    @default(now())
  recordedById       String?                     @db.Uuid
  createdAt          DateTime                    @default(now())
  updatedAt          DateTime                    @updatedAt

  organisation Organisation @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  patient      Patient      @relation(fields: [patientId], references: [id], onDelete: Restrict)
  encounter    Encounter?   @relation(fields: [encounterId], references: [id], onDelete: Restrict)

  @@index([tenantId, patientId, clinicalStatus])
  @@index([tenantId, patientId, category, recordedAt])
  @@index([tenantId, code])
}

/// What the patient reports taking, including outside prescriptions.
model MedicationStatement {
  id             String                    @id @db.Uuid
  tenantId       String                    @db.Uuid
  patientId      String                    @db.Uuid
  encounterId    String?                   @db.Uuid
  /// RxNorm concept id. Coded, so a string.
  rxnormCode     String?
  display        String
  sigText        String?
  status         MedicationStatementStatus @default(ACTIVE)
  source         MedicationSource          @default(REPORTED)
  effectiveStart DateTime?                 @db.Date
  effectiveEnd   DateTime?                 @db.Date
  reportedAt     DateTime                  @default(now())
  note           String?
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt

  organisation Organisation @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  patient      Patient      @relation(fields: [patientId], references: [id], onDelete: Restrict)
  encounter    Encounter?   @relation(fields: [encounterId], references: [id], onDelete: Restrict)

  @@index([tenantId, patientId, status])
}

/// A prescription. Shaped like FHIR MedicationRequest so the eRx vendor behind
/// the `erx` adapter seam stays swappable.
model MedicationRequest {
  id                 String                  @id @db.Uuid
  tenantId           String                  @db.Uuid
  patientId          String                  @db.Uuid
  encounterId        String?                 @db.Uuid
  prescriberId       String                  @db.Uuid
  rxnormCode         String?
  ndcCode            String?
  display            String
  /// Structured sig, authored by the sig builder and rendered into sigText.
  sig                Json                    @default("{}")
  sigText            String
  quantity           Decimal                 @db.Decimal(12, 3)
  quantityUnit       String
  refills            Int                     @default(0)
  daysSupply         Int?
  dispenseAsWritten  Boolean                 @default(false)
  /// DEA schedule as a string ("2", "3", "4", "5"); jurisdictional, so coded.
  controlledSchedule String?
  pharmacyName       String?
  /// NCPDP pharmacy id from the address book. Coded.
  pharmacyNcpdpId    String?
  status             MedicationRequestStatus @default(DRAFT)
  intent             MedicationRequestIntent @default(ORDER)
  /// Opaque reference returned by the eRx adapter. Never PHI.
  erxRef             String?
  writtenAt          DateTime                @default(now())
  transmittedAt      DateTime?
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt

  organisation Organisation @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  patient      Patient      @relation(fields: [patientId], references: [id], onDelete: Restrict)
  encounter    Encounter?   @relation(fields: [encounterId], references: [id], onDelete: Restrict)
  prescriber   User         @relation(fields: [prescriberId], references: [id], onDelete: Restrict)

  @@index([tenantId, patientId, status])
  @@index([tenantId, status, writtenAt])
  @@index([tenantId, prescriberId, status])
}

model AllergyIntolerance {
  id                  String                @id @db.Uuid
  tenantId            String                @db.Uuid
  patientId           String                @db.Uuid
  type                AllergyType           @default(ALLERGY)
  category            AllergyCategory       @default(MEDICATION)
  criticality         AllergyCriticality    @default(UNABLE_TO_ASSESS)
  clinicalStatus      AllergyClinicalStatus @default(ACTIVE)
  /// RxNorm or SNOMED CT substance code. Coded, so a string plus its system.
  substanceCode       String?
  substanceCodeSystem String?
  substanceDisplay    String
  /// SNOMED CT manifestation codes; repeating by definition.
  reactionCodes       String[]
  reactionText        String?
  severity            ReactionSeverity?
  onsetDate           DateTime?             @db.Date
  note                String?
  recordedAt          DateTime              @default(now())
  recordedById        String?               @db.Uuid
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  organisation Organisation @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  patient      Patient      @relation(fields: [patientId], references: [id], onDelete: Restrict)

  @@index([tenantId, patientId, clinicalStatus])
  @@index([tenantId, patientId, criticality])
}

model Immunization {
  id                   String             @id @db.Uuid
  tenantId             String             @db.Uuid
  patientId            String             @db.Uuid
  encounterId          String?            @db.Uuid
  status               ImmunizationStatus @default(COMPLETED)
  /// CDC CVX vaccine code. Coded.
  cvxCode              String
  /// CDC MVX manufacturer code. Coded.
  mvxCode              String?
  ndcCode              String?
  display              String
  lotNumber            String?
  expirationDate       DateTime?          @db.Date
  siteCode             String?
  routeCode            String?
  doseQuantity         Decimal?           @db.Decimal(8, 3)
  doseUnit             String?
  administeredAt       DateTime
  administeredById     String?            @db.Uuid
  /// Vaccine Information Statement publication date, required for reporting.
  visDate              DateTime?          @db.Date
  refusalReasonCode    String?
  reportedToRegistryAt DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  organisation Organisation @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  patient      Patient      @relation(fields: [patientId], references: [id], onDelete: Restrict)
  encounter    Encounter?   @relation(fields: [encounterId], references: [id], onDelete: Restrict)

  @@index([tenantId, patientId, administeredAt])
  @@index([tenantId, cvxCode, administeredAt])
}

/// Vitals, in-house labs, SDOH answers and survey scores. Discrete values that
/// arrive from an outside lab land in ResultObservation under a
/// DiagnosticReport instead, so a report's lines can never orphan.
model Observation {
  id                 String              @id @db.Uuid
  tenantId           String              @db.Uuid
  patientId          String              @db.Uuid
  encounterId        String?             @db.Uuid
  category           ObservationCategory @default(VITAL_SIGNS)
  status             ObservationStatus   @default(FINAL)
  /// LOINC code where one exists. Coded, so a string plus its system.
  loincCode          String?
  code               String
  codeSystem         String              @default("http://loinc.org")
  display            String
  valueNumber        Decimal?            @db.Decimal(18, 6)
  valueText          String?
  valueCode          String?
  valueBoolean       Boolean?
  /// UCUM unit. Coded.
  unit               String?
  referenceLow       Decimal?            @db.Decimal(18, 6)
  referenceHigh      Decimal?            @db.Decimal(18, 6)
  /// HL7 ObservationInterpretation code, e.g. "H", "L", "A". Coded.
  interpretationCode String?
  bodySiteCode       String?
  effectiveAt        DateTime
  issuedAt           DateTime?
  performerId        String?             @db.Uuid
  /// Set when the value was promoted out of a form submission.
  formSubmissionId   String?             @db.Uuid
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  organisation Organisation    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  patient      Patient         @relation(fields: [patientId], references: [id], onDelete: Restrict)
  encounter    Encounter?      @relation(fields: [encounterId], references: [id], onDelete: Restrict)
  submission   FormSubmission? @relation(fields: [formSubmissionId], references: [id], onDelete: SetNull)

  /// Results by patient and date, plus the flowsheet / growth-chart path.
  @@index([tenantId, patientId, effectiveAt])
  @@index([tenantId, patientId, loincCode, effectiveAt])
  @@index([tenantId, patientId, category, effectiveAt])
  @@index([tenantId, encounterId])
}

/// An order: lab, imaging, procedure, referral or therapy, one table.
model ServiceRequest {
  id                String                 @id @db.Uuid
  tenantId          String                 @db.Uuid
  patientId         String                 @db.Uuid
  encounterId       String?                @db.Uuid
  orderedById       String                 @db.Uuid
  category          ServiceRequestCategory @default(LAB)
  status            ServiceRequestStatus   @default(DRAFT)
  intent            ServiceRequestIntent   @default(ORDER)
  priority          OrderPriority          @default(ROUTINE)
  /// Orderable code from the tenant's compendium (LOINC, CPT, local). Coded.
  code              String
  codeSystem        String
  display           String
  specimenTypeCode  String?
  /// ICD-10-CM codes justifying medical necessity; repeating by definition.
  reasonCodes       String[]
  /// Ask-at-order-entry answers, keyed by the compendium item's question ids.
  aoeAnswers        Json?
  note              String?
  requisitionNumber String?
  performingLabName String?
  /// Opaque reference returned by the labs adapter. Never PHI.
  labRef            String?
  requestedAt       DateTime               @default(now())
  scheduledFor      DateTime?
  transmittedAt     DateTime?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  organisation Organisation @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  patient      Patient      @relation(fields: [patientId], references: [id], onDelete: Restrict)
  encounter    Encounter?   @relation(fields: [encounterId], references: [id], onDelete: Restrict)
  orderedBy    User         @relation(fields: [orderedById], references: [id], onDelete: Restrict)

  specimens      Specimen[]
  reports        DiagnosticReport[]
  imagingStudies ImagingStudy[]

  /// The pended-orders tray and the outstanding-orders report.
  @@index([tenantId, status, requestedAt])
  @@index([tenantId, patientId, requestedAt])
  @@index([tenantId, orderedById, status])
  @@index([tenantId, category, status, priority])
}

model Specimen {
  id                   String         @id @db.Uuid
  tenantId             String         @db.Uuid
  patientId            String         @db.Uuid
  serviceRequestId     String?        @db.Uuid
  status               SpecimenStatus @default(AVAILABLE)
  accessionNumber      String?
  /// SNOMED CT specimen type. Coded.
  typeCode             String
  typeDisplay          String
  collectionMethodCode String?
  bodySiteCode         String?
  collectedAt          DateTime?
  collectedById        String?        @db.Uuid
  receivedAt           DateTime?
  containerType        String?
  volumeValue          Decimal?       @db.Decimal(10, 3)
  volumeUnit           String?
  rejectionReason      String?
  note                 String?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  organisation   Organisation    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  patient        Patient         @relation(fields: [patientId], references: [id], onDelete: Restrict)
  serviceRequest ServiceRequest? @relation(fields: [serviceRequestId], references: [id], onDelete: Restrict)

  reports DiagnosticReport[]

  @@unique([tenantId, accessionNumber])
  @@index([tenantId, patientId, collectedAt])
  @@index([tenantId, serviceRequestId])
}

/// A result report from a lab or imaging centre. Its discrete values live in
/// ResultObservation rows.
model DiagnosticReport {
  id                String                 @id @db.Uuid
  tenantId          String                 @db.Uuid
  patientId         String                 @db.Uuid
  encounterId       String?                @db.Uuid
  serviceRequestId  String?                @db.Uuid
  specimenId        String?                @db.Uuid
  status            DiagnosticReportStatus @default(FINAL)
  category          ServiceRequestCategory @default(LAB)
  /// LOINC panel code. Coded.
  code              String
  codeSystem        String                 @default("http://loinc.org")
  display           String
  performingLabName String?
  abnormalFlag      AbnormalFlag           @default(NORMAL)
  narrative         String?
  /// Object-storage key for the original HL7 or PDF payload.
  rawStorageKey     String?
  effectiveAt       DateTime?
  issuedAt          DateTime               @default(now())
  reviewedById      String?                @db.Uuid
  reviewedAt        DateTime?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  organisation   Organisation    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  patient        Patient         @relation(fields: [patientId], references: [id], onDelete: Restrict)
  encounter      Encounter?      @relation(fields: [encounterId], references: [id], onDelete: Restrict)
  serviceRequest ServiceRequest? @relation(fields: [serviceRequestId], references: [id], onDelete: Restrict)
  specimen       Specimen?       @relation(fields: [specimenId], references: [id], onDelete: Restrict)

  results        ResultObservation[]
  imagingStudies ImagingStudy[]

  /// Results by patient and date, plus the unreviewed-results sign-off queue.
  @@index([tenantId, patientId, issuedAt])
  @@index([tenantId, status, issuedAt])
  @@index([tenantId, reviewedAt, abnormalFlag])
  @@index([tenantId, serviceRequestId])
}

/// One discrete analyte within a DiagnosticReport.
model ResultObservation {
  id                 String            @id @db.Uuid
  tenantId           String            @db.Uuid
  diagnosticReportId String            @db.Uuid
  patientId          String            @db.Uuid
  status             ObservationStatus @default(FINAL)
  sequence           Int
  loincCode          String?
  code               String
  codeSystem         String            @default("http://loinc.org")
  display            String
  valueNumber        Decimal?          @db.Decimal(18, 6)
  valueText          String?
  valueCode          String?
  unit               String?
  referenceLow       Decimal?          @db.Decimal(18, 6)
  referenceHigh      Decimal?          @db.Decimal(18, 6)
  referenceRangeText String?
  interpretationCode String?
  abnormalFlag       AbnormalFlag      @default(NORMAL)
  effectiveAt        DateTime
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  organisation     Organisation     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  patient          Patient          @relation(fields: [patientId], references: [id], onDelete: Restrict)
  diagnosticReport DiagnosticReport @relation(fields: [diagnosticReportId], references: [id], onDelete: Cascade)

  @@unique([diagnosticReportId, sequence])
  @@index([tenantId, patientId, loincCode, effectiveAt])
  @@index([tenantId, patientId, effectiveAt])
}

/// The typed inbox. One work engine; the streams are `type` filters, not
/// separate systems. `assigneeType` picks which of the two assignee columns is
/// populated: exactly one is non-null, enforced in the service layer.
model Task {
  id              String           @id @db.Uuid
  tenantId        String           @db.Uuid
  type            TaskType         @default(GENERAL)
  status          TaskStatus       @default(OPEN)
  priority        TaskPriority     @default(NORMAL)
  patientId       String?          @db.Uuid
  encounterId     String?          @db.Uuid
  /// Model name of the thing the task is about, e.g. "DiagnosticReport".
  subjectType     String?
  subjectId       String?          @db.Uuid
  title           String
  description     String?
  assigneeType    TaskAssigneeType @default(USER)
  assigneeUserId  String?          @db.Uuid
  /// Team pools are configuration keys, not rows, until team management ships.
  assigneeTeamKey String?
  dueAt           DateTime?
  slaState        TaskSlaState     @default(OK)
  /// FYI tasks auto-close at this instant so the inbox shrinks by default.
  expiresAt       DateTime?
  /// Domain event id that created this task; makes routing idempotent under
  /// at-least-once delivery, together with the unique constraint below.
  sourceEventId   String?
  completedAt     DateTime?
  completedById   String?          @db.Uuid
  outcome         String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  organisation Organisation @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  patient      Patient?     @relation(fields: [patientId], references: [id], onDelete: Restrict)
  encounter    Encounter?   @relation(fields: [encounterId], references: [id], onDelete: Restrict)
  assigneeUser User?        @relation(fields: [assigneeUserId], references: [id], onDelete: Restrict)

  @@unique([tenantId, sourceEventId, type])
  @@index([tenantId, assigneeType, assigneeUserId, status])
  @@index([tenantId, assigneeTeamKey, status])
  @@index([tenantId, type, status, dueAt])
  @@index([tenantId, status, slaState, dueAt])
  @@index([tenantId, patientId, status])
  @@index([tenantId, expiresAt])
}

/// One threading model for portal messaging and staff chat.
model MessageThread {
  id            String     @id @db.Uuid
  tenantId      String     @db.Uuid
  kind          ThreadKind @default(STAFF)
  patientId     String?    @db.Uuid
  subject       String
  lastMessageAt DateTime?
  closedAt      DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  organisation Organisation @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  patient      Patient?     @relation(fields: [patientId], references: [id], onDelete: Restrict)

  messages Message[]

  @@index([tenantId, kind, lastMessageAt])
  @@index([tenantId, patientId, lastMessageAt])
}

model Message {
  id              String            @id @db.Uuid
  tenantId        String            @db.Uuid
  threadId        String            @db.Uuid
  senderType      MessageSenderType @default(USER)
  senderUserId    String?           @db.Uuid
  senderPatientId String?           @db.Uuid
  body            String
  sentAt          DateTime          @default(now())
  readAt          DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  organisation Organisation  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  thread       MessageThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  senderUser   User?         @relation(fields: [senderUserId], references: [id], onDelete: Restrict)

  @@index([tenantId, threadId, sentAt])
  @@index([tenantId, senderUserId, sentAt])
}

// ---------------------------------------------------------------------------
// Financial
// ---------------------------------------------------------------------------

/// A fee-sheet line. `diagnosisPointers` are 1-based indices into the claim's
/// diagnosis list, matching 837P SV107, which is what "justify" means on the
/// fee sheet.
model ChargeItem {
  id                    String           @id @db.Uuid
  tenantId              String           @db.Uuid
  facilityId            String           @db.Uuid
  encounterId           String           @db.Uuid
  patientId             String           @db.Uuid
  /// CPT or HCPCS code. Coded, so a string plus its system.
  code                  String
  codeSystem            String           @default("http://www.ama-assn.org/go/cpt")
  display               String
  /// CPT modifiers, up to four in 837P. Repeating by definition.
  modifiers             String[]
  units                 Decimal          @default(1) @db.Decimal(9, 3)
  unitPriceCents        Int
  totalPriceCents       Int
  diagnosisPointers     Int[]
  renderingProviderId   String           @db.Uuid
  supervisingProviderId String?          @db.Uuid
  placeOfServiceCode    String?
  serviceDate           DateTime         @db.Date
  status                ChargeItemStatus @default(OPEN)
  voidReason            String?
  voidedById            String?          @db.Uuid
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  organisation      Organisation @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  facility          Facility     @relation(fields: [facilityId], references: [id], onDelete: Restrict)
  encounter         Encounter    @relation(fields: [encounterId], references: [id], onDelete: Restrict)
  patient           Patient      @relation(fields: [patientId], references: [id], onDelete: Restrict)
  renderingProvider User         @relation(fields: [renderingProviderId], references: [id], onDelete: Restrict)

  claimLines         ClaimLine[]
  paymentAllocations PaymentAllocation[]

  @@index([tenantId, encounterId])
  @@index([tenantId, patientId, status])
  @@index([tenantId, status, serviceDate])
}

/// The claim lifecycle spine. `snapshot` is the as-built 837P payload so a
/// resubmission is byte-reproducible even after the encounter is edited.
model Claim {
  id                         String         @id @db.Uuid
  tenantId                   String         @db.Uuid
  patientId                  String         @db.Uuid
  encounterId                String         @db.Uuid
  coverageId                 String         @db.Uuid
  payerId                    String         @db.Uuid
  status                     ClaimStatus    @default(DRAFT)
  frequency                  ClaimFrequency @default(ORIGINAL)
  /// Claim-level diagnosis list; ChargeItem.diagnosisPointers index into it.
  diagnosisCodes             String[]
  totalChargedCents          Int            @default(0)
  totalPaidCents             Int            @default(0)
  totalAdjustedCents         Int            @default(0)
  patientResponsibilityCents Int            @default(0)
  /// Secondary claim cascaded from this one's primary adjudication.
  secondaryOfId              String?        @db.Uuid
  /// Corrected or voided claim that this one replaces.
  priorClaimId               String?        @db.Uuid
  /// ISA/GS/ST and payer claim control numbers, keyed by segment.
  controlNumbers             Json           @default("{}")
  snapshot                   Json           @default("{}")
  statusReason               String?
  submittedAt                DateTime?
  acknowledgedAt             DateTime?
  adjudicatedAt              DateTime?
  createdAt                  DateTime       @default(now())
  updatedAt                  DateTime       @updatedAt

  organisation Organisation @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  patient      Patient      @relation(fields: [patientId], references: [id], onDelete: Restrict)
  encounter    Encounter    @relation(fields: [encounterId], references: [id], onDelete: Restrict)
  coverage     Coverage     @relation(fields: [coverageId], references: [id], onDelete: Restrict)
  payer        Payer        @relation(fields: [payerId], references: [id], onDelete: Restrict)
  secondaryOf  Claim?       @relation("ClaimSecondary", fields: [secondaryOfId], references: [id], onDelete: Restrict)
  priorClaim   Claim?       @relation("ClaimCorrection", fields: [priorClaimId], references: [id], onDelete: Restrict)

  secondaryClaims    Claim[]              @relation("ClaimSecondary")
  correctionClaims   Claim[]              @relation("ClaimCorrection")
  lines              ClaimLine[]
  statusHistory      ClaimStatusHistory[]
  remittanceLines    RemittanceLine[]
  paymentAllocations PaymentAllocation[]

  /// The accounts-receivable work queue: claims by status, oldest first.
  @@index([tenantId, status, submittedAt])
  @@index([tenantId, status, createdAt])
  @@index([tenantId, patientId, createdAt])
  @@index([tenantId, payerId, status])
}

model ClaimLine {
  id                String    @id @db.Uuid
  tenantId          String    @db.Uuid
  claimId           String    @db.Uuid
  chargeItemId      String    @db.Uuid
  sequence          Int
  code              String
  codeSystem        String    @default("http://www.ama-assn.org/go/cpt")
  modifiers         String[]
  units             Decimal   @default(1) @db.Decimal(9, 3)
  chargedCents      Int
  allowedCents      Int?
  paidCents         Int       @default(0)
  adjustedCents     Int       @default(0)
  diagnosisPointers Int[]
  serviceDateFrom   DateTime  @db.Date
  serviceDateTo     DateTime? @db.Date
  statusReason      String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  organisation Organisation @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  claim        Claim        @relation(fields: [claimId], references: [id], onDelete: Cascade)
  chargeItem   ChargeItem   @relation(fields: [chargeItemId], references: [id], onDelete: Restrict)

  remittanceLines    RemittanceLine[]
  paymentAllocations PaymentAllocation[]

  @@unique([claimId, sequence])
  @@index([tenantId, claimId])
  @@index([tenantId, chargeItemId])
}

/// Every claim transition, whatever produced it. This replaces the separate
/// EDI history screen: 999, 277 and 835 all write here.
model ClaimStatusHistory {
  id         String      @id @db.Uuid
  tenantId   String      @db.Uuid
  claimId    String      @db.Uuid
  status     ClaimStatus
  occurredAt DateTime    @default(now())
  /// What caused the transition: "system", "999", "277", "835", "user".
  source     String
  detail     Json?
  byUserId   String?     @db.Uuid
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  organisation Organisation @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  claim        Claim        @relation(fields: [claimId], references: [id], onDelete: Cascade)

  @@index([tenantId, claimId, occurredAt])
  @@index([tenantId, status, occurredAt])
}

/// Money received, from a patient or from a payer. Allocation to specific
/// charges is a separate table so one cheque can pay many claims.
model Payment {
  id           String        @id @db.Uuid
  tenantId     String        @db.Uuid
  patientId    String?       @db.Uuid
  payerId      String?       @db.Uuid
  remittanceId String?       @db.Uuid
  source       PaymentSource @default(PATIENT)
  method       PaymentMethod @default(CARD)
  status       PaymentStatus @default(PENDING)
  amountCents  Int
  currency     String        @default("USD")
  /// Cheque number or EFT trace number.
  reference    String?
  /// Opaque gateway reference from the payments adapter. Never card data.
  adapterRef   String?
  receivedAt   DateTime      @default(now())
  postedAt     DateTime?
  postedById   String?       @db.Uuid
  note         String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  organisation Organisation @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  patient      Patient?     @relation(fields: [patientId], references: [id], onDelete: Restrict)
  payer        Payer?       @relation(fields: [payerId], references: [id], onDelete: Restrict)
  remittance   Remittance?  @relation(fields: [remittanceId], references: [id], onDelete: Restrict)

  allocations PaymentAllocation[]

  @@index([tenantId, patientId, receivedAt])
  @@index([tenantId, status, receivedAt])
  @@index([tenantId, remittanceId])
}

/// Applies part of a Payment to a claim, claim line or charge. The signed
/// running balance for a patient is charges minus allocations, so there is one
/// ledger and no second source of truth.
model PaymentAllocation {
  id                   String   @id @db.Uuid
  tenantId             String   @db.Uuid
  paymentId            String   @db.Uuid
  patientId            String   @db.Uuid
  claimId              String?  @db.Uuid
  claimLineId          String?  @db.Uuid
  chargeItemId         String?  @db.Uuid
  amountCents          Int
  /// X12 CAS group code when this allocation records a contractual write-off.
  adjustmentGroupCode  String?
  /// X12 CARC reason code. Coded.
  adjustmentReasonCode String?
  appliedAt            DateTime @default(now())
  note                 String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  organisation Organisation @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  payment      Payment      @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  patient      Patient      @relation(fields: [patientId], references: [id], onDelete: Restrict)
  claim        Claim?       @relation(fields: [claimId], references: [id], onDelete: Restrict)
  claimLine    ClaimLine?   @relation(fields: [claimLineId], references: [id], onDelete: Restrict)
  chargeItem   ChargeItem?  @relation(fields: [chargeItemId], references: [id], onDelete: Restrict)

  @@index([tenantId, paymentId])
  @@index([tenantId, patientId, appliedAt])
  @@index([tenantId, claimId])
}

/// An 835 electronic remittance advice. Parsing produces RemittanceLine rows;
/// posting produces Payment plus PaymentAllocation rows.
model Remittance {
  id               String           @id @db.Uuid
  tenantId         String           @db.Uuid
  payerId          String           @db.Uuid
  status           RemittanceStatus @default(RECEIVED)
  checkOrEftNumber String?
  totalPaidCents   Int              @default(0)
  receivedAt       DateTime         @default(now())
  paidAt           DateTime?
  /// Object-storage key for the raw 835 payload.
  rawStorageKey    String?
  parsed           Json?
  exceptionCount   Int              @default(0)
  postedAt         DateTime?
  postedById       String?          @db.Uuid
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  organisation Organisation @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  payer        Payer        @relation(fields: [payerId], references: [id], onDelete: Restrict)

  lines    RemittanceLine[]
  payments Payment[]

  @@index([tenantId, status, receivedAt])
  @@index([tenantId, payerId, receivedAt])
}

/// One service line within an 835. Unmatched lines become exception Tasks
/// rather than being silently dropped.
model RemittanceLine {
  id                         String    @id @db.Uuid
  tenantId                   String    @db.Uuid
  remittanceId               String    @db.Uuid
  claimId                    String?   @db.Uuid
  claimLineId                String?   @db.Uuid
  sequence                   Int
  /// Payer's claim control number from CLP01, used for matching.
  payerControlNumber         String?
  code                       String?
  chargedCents               Int       @default(0)
  allowedCents               Int       @default(0)
  paidCents                  Int       @default(0)
  patientResponsibilityCents Int       @default(0)
  adjustmentGroupCode        String?
  adjustmentReasonCode       String?
  /// X12 RARC remark codes. Repeating by definition.
  remarkCodes                String[]
  serviceDateFrom            DateTime? @db.Date
  matched                    Boolean   @default(false)
  createdAt                  DateTime  @default(now())
  updatedAt                  DateTime  @updatedAt

  organisation Organisation @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  remittance   Remittance   @relation(fields: [remittanceId], references: [id], onDelete: Cascade)
  claim        Claim?       @relation(fields: [claimId], references: [id], onDelete: Restrict)
  claimLine    ClaimLine?   @relation(fields: [claimLineId], references: [id], onDelete: Restrict)

  @@unique([remittanceId, sequence])
  @@index([tenantId, claimId])
  @@index([tenantId, remittanceId, matched])
}

/// A patient statement, including its text-to-pay link token.
model Statement {
  id               String             @id @db.Uuid
  tenantId         String             @db.Uuid
  patientId        String             @db.Uuid
  status           StatementStatus    @default(DRAFT)
  balanceCents     Int
  /// How many notices have gone out. Zero until the first one does.
  dunningCycle     Int                @default(0)
  /// When the last notice went out, which is what the interval is measured from.
  lastNoticeAt     DateTime?
  /// Set while the practice has agreed not to chase: a dispute, or hardship.
  holdUntil        DateTime?
  holdReason       String?
  /// Why pursuit stopped, recorded when the statement is written off.
  closedReason     String?
  periodStart      DateTime?          @db.Date
  periodEnd        DateTime?          @db.Date
  generatedAt      DateTime           @default(now())
  deliveredVia     StatementDelivery?
  deliveredAt      DateTime?
  pdfStorageKey    String?
  /// Single-use token behind the pay link. Rotated on every regeneration.
  payLinkToken     String?            @unique
  payLinkExpiresAt DateTime?
  paidAt           DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  organisation Organisation @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  patient      Patient      @relation(fields: [patientId], references: [id], onDelete: Restrict)

  @@index([tenantId, patientId, generatedAt])
  @@index([tenantId, status, generatedAt])
  @@index([tenantId, status, lastNoticeAt])
}

// ---------------------------------------------------------------------------
// Form engine
// ---------------------------------------------------------------------------

/// A versioned form. Publishing freezes the row: a change is a new version, so
/// an in-flight submission always keeps the definition it was authored against.
///
/// `definition` is the authored document. `compiled` holds the publish-time
/// artefacts (zod validator descriptor, UI render tree, print layout, FHIR
/// Questionnaire mapping). `promotionManifest` is the list of fields to
/// materialize; see FormPromotedValue for the promotion rule.
model FormDefinition {
  id                String      @id @db.Uuid
  tenantId          String      @db.Uuid
  key               String
  version           Int
  status            FormStatus  @default(DRAFT)
  title             String
  description       String?
  bindTo            FormBinding @default(ENCOUNTER)
  definition        Json        @default("{}")
  compiled          Json?
  promotionManifest Json?
  publishedAt       DateTime?
  publishedById     String?     @db.Uuid
  retiredAt         DateTime?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  organisation Organisation @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  submissions    FormSubmission[]
  promotedValues FormPromotedValue[]

  @@unique([tenantId, key, version])
  @@index([tenantId, bindTo, status])
  @@index([tenantId, key, status])
}

/// A completed form. `values` is one JSONB document validated against the
/// pinned definition's generated zod schema. This is deliberately NOT EAV:
/// there is exactly one row per submission, never one row per answered field.
model FormSubmission {
  id                String               @id @db.Uuid
  tenantId          String               @db.Uuid
  formDefinitionId  String               @db.Uuid
  patientId         String               @db.Uuid
  encounterId       String?              @db.Uuid
  status            FormSubmissionStatus @default(IN_PROGRESS)
  values            Json                 @default("{}")
  completedByType   FormCompletedByType  @default(USER)
  completedByUserId String?              @db.Uuid
  completedAt       DateTime?
  signedAt          DateTime?
  signedById        String?              @db.Uuid
  /// Clinically effective instant, which is what promoted values are graphed
  /// against; it may differ from when the form was keyed in.
  effectiveAt       DateTime             @default(now())
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  organisation   Organisation   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  formDefinition FormDefinition @relation(fields: [formDefinitionId], references: [id], onDelete: Restrict)
  patient        Patient        @relation(fields: [patientId], references: [id], onDelete: Restrict)
  encounter      Encounter?     @relation(fields: [encounterId], references: [id], onDelete: Restrict)

  promotedValues FormPromotedValue[]
  observations   Observation[]
  consentGrants  ConsentGrant[]

  @@index([tenantId, patientId, effectiveAt])
  @@index([tenantId, formDefinitionId, createdAt])
  @@index([tenantId, encounterId])
}

/// Promoted values: the indexed, queryable projection of selected form fields.
///
/// The promotion rule, implemented and unit-tested in `src/forms.ts`:
///
///   1. A field is promoted if and only if the published definition's
///      promotion manifest lists it. Authors opt in per field by marking it
///      graphable, searchable or reportable; nothing is promoted implicitly.
///   2. Promotion runs on write, inside the same transaction as the
///      FormSubmission upsert. Rows for a submission are replaced wholesale on
///      every save, so a re-save can never leave a stale value behind.
///   3. Exactly one row per (submission, fieldKey, repeatIndex). A field inside
///      a repeating group produces one row per repetition, indexed from 0.
///   4. Exactly one typed value column is populated, chosen by the field's
///      declared type. Quantity fields populate valueQuantity plus valueUnit;
///      coded fields populate valueCode plus valueCodeSystem.
///   5. Null, undefined and empty-string answers produce no row at all, so
///      "unanswered" and "answered blank" stay distinguishable and the table
///      stays sparse.
///   6. `effectiveAt` is copied from the submission, so graphing a promoted
///      field over time is one index scan and never an EAV join tree.
///
/// This is a fixed table with typed columns rather than per-form dynamic DDL,
/// because dynamic DDL would fight the expand/contract migration discipline.
model FormPromotedValue {
  id                String    @id @db.Uuid
  tenantId          String    @db.Uuid
  formSubmissionId  String    @db.Uuid
  formDefinitionId  String    @db.Uuid
  patientId         String    @db.Uuid
  /// Denormalized from the definition so a query needs no join to filter.
  definitionKey     String
  definitionVersion Int
  fieldKey          String
  repeatIndex       Int       @default(0)
  valueText         String?
  valueNumber       Decimal?  @db.Decimal(18, 6)
  valueDate         DateTime?
  valueBoolean      Boolean?
  valueCode         String?
  valueCodeSystem   String?
  valueQuantity     Decimal?  @db.Decimal(18, 6)
  valueUnit         String?
  effectiveAt       DateTime
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  organisation   Organisation   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  submission     FormSubmission @relation(fields: [formSubmissionId], references: [id], onDelete: Cascade)
  formDefinition FormDefinition @relation(fields: [formDefinitionId], references: [id], onDelete: Restrict)
  patient        Patient        @relation(fields: [patientId], references: [id], onDelete: Restrict)

  @@unique([formSubmissionId, fieldKey, repeatIndex])
  @@index([tenantId, definitionKey, fieldKey, effectiveAt])
  @@index([tenantId, patientId, fieldKey, effectiveAt])
  @@index([tenantId, formDefinitionId])
}

// ---------------------------------------------------------------------------
// Terminology, consent, audit
// ---------------------------------------------------------------------------

/// The bring-your-own terminology cache. Openrunic ships no code content:
/// ICD-10-CM, CPT, LOINC, SNOMED CT and RxNorm all carry their own licences,
/// so each deployment loads only what it is licensed for. Clinical tables store
/// the raw code plus its system and resolve display text through here when it
/// is available, which means a missing code set degrades display, never data.
model TerminologyCode {
  id         String   @id @db.Uuid
  tenantId   String   @db.Uuid
  /// Canonical system URI, e.g. "http://loinc.org". Deliberately a string and
  /// not an enum: a new system must be loadable without a migration.
  system     String
  code       String
  display    String
  /// Empty string rather than NULL so it participates in the unique key.
  version    String   @default("")
  parentCode String?
  isActive   Boolean  @default(true)
  properties Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  organisation Organisation @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, system, code, version])
  @@index([tenantId, system, isActive])
  @@index([tenantId, system, display])
}

/// A recorded consent or authorization: treatment consent, portal access,
/// information sharing, research participation, communication preferences.
model ConsentGrant {
  id               String        @id @db.Uuid
  tenantId         String        @db.Uuid
  patientId        String        @db.Uuid
  scope            ConsentScope
  status           ConsentStatus @default(ACTIVE)
  /// Set when a related person granted it on the patient's behalf.
  relatedPersonId  String?       @db.Uuid
  /// Signed paper or generated PDF backing the grant.
  documentId       String?       @db.Uuid
  /// Portal consent forms are FormSubmissions.
  formSubmissionId String?       @db.Uuid
  policyText       String?
  effectiveFrom    DateTime      @default(now())
  effectiveTo      DateTime?
  revokedAt        DateTime?
  revokedReason    String?
  recordedById     String?       @db.Uuid
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  organisation  Organisation    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  patient       Patient         @relation(fields: [patientId], references: [id], onDelete: Restrict)
  relatedPerson RelatedPerson?  @relation(fields: [relatedPersonId], references: [id], onDelete: Restrict)
  document      Document?       @relation(fields: [documentId], references: [id], onDelete: Restrict)
  submission    FormSubmission? @relation(fields: [formSubmissionId], references: [id], onDelete: Restrict)

  @@index([tenantId, patientId, scope, status])
  @@index([tenantId, status, effectiveTo])
}

/// Append-only, hash-chained audit log. Every security-relevant action lands
/// here: who did what to which record, when, under which purpose of use. The
/// chaining rule is documented at the top of this file.
///
/// Rows are never updated and never deleted. `updatedAt` exists only for
/// convention; a differing `updatedAt` is itself evidence of tampering, because
/// nothing in the application ever writes an AuditEvent row twice.
model AuditEvent {
  id           String   @id @db.Uuid
  tenantId     String   @db.Uuid
  /// Monotonic per tenant, starting at 1. A gap means events were lost.
  seq          BigInt
  occurredAt   DateTime @default(now())
  /// Kind of principal: "user", "patient", "system", "service", "adapter".
  /// A string rather than an enum so plugins can introduce actor kinds.
  actorType    String
  actorId      String
  actorDisplay String?
  action       String
  targetType   String
  targetId     String?
  patientId    String?  @db.Uuid
  encounterId  String?  @db.Uuid
  facilityId   String?  @db.Uuid
  /// HL7 PurposeOfUse code, e.g. "TREAT", "HPAYMT", "HOPERAT". Coded.
  purposeOfUse String?
  breakglass   Boolean  @default(false)
  outcome      String   @default("success")
  sourceIp     String?
  userAgent    String?
  metadata     Json?
  prevHash     String
  hash         String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  organisation Organisation @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, seq])
  @@unique([tenantId, hash])
  @@index([tenantId, targetType, targetId])
  @@index([tenantId, patientId, occurredAt])
  @@index([tenantId, occurredAt])
  @@index([tenantId, actorId, occurredAt])
  @@index([tenantId, breakglass, occurredAt])
  @@index([targetType, targetId])
  @@index([occurredAt])
}

/// A referral out to another clinician, and the loop it has to close.
///
/// The defining failure of referral management is not sending one - it is never
/// finding out what happened. A patient is referred, and the practice that
/// referred them has no idea whether they were seen, whether the specialist
/// declined, or whether a report came back and went unread. That gap is where
/// diagnoses are lost, and it is the reason this model carries four separate
/// timestamps rather than one status: sent, scheduled, seen, and report
/// received. Each is a distinct fact about the world, and collapsing them into
/// a status would make "we sent it" indistinguishable from "they went".
///
/// The receiving side is free text plus an optional NPI rather than a relation.
/// The practice being referred to is almost never in this practice's own
/// directory, and requiring it to be would mean either refusing the referral or
/// inventing a directory entry for a clinic nobody here has a relationship with.
model Referral {
  id           String  @id @db.Uuid
  tenantId     String  @db.Uuid
  patientId    String  @db.Uuid
  encounterId  String? @db.Uuid
  /// The clinician making the referral, who owns the loop until it closes.
  referredById String  @db.Uuid

  status   ReferralStatus   @default(DRAFT)
  priority ReferralPriority @default(ROUTINE)

  /// The specialty being referred to, as a code from the tenant's own list.
  specialtyCode    String
  specialtyDisplay String

  /// Who it is going to. Free text because the receiving practice is almost
  /// never in this practice's directory; the NPI is there when it is known.
  receivingPractice String
  receivingNpi      String?
  receivingPhone    String?

  /// ICD-10-CM codes justifying the referral; repeating by definition.
  reasonCodes String[]
  reasonText  String?
  note        String?

  /// Set once the practice has an authorisation, so the tray can show what is
  /// waiting on one. The 278 exchange that produces it lives elsewhere.
  authorisationNumber String?

  /// The four facts the loop is made of. Each is separately unknown, and a
  /// status alone cannot say which of them is missing.
  sentAt           DateTime?
  scheduledFor     DateTime?
  seenAt           DateTime?
  reportReceivedAt DateTime?
  /// The report itself, once it arrives and is filed.
  reportDocumentId String?   @db.Uuid

  /// Why the receiving practice declined, when they did.
  declinedReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organisation   Organisation @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  patient        Patient      @relation(fields: [patientId], references: [id], onDelete: Restrict)
  encounter      Encounter?   @relation(fields: [encounterId], references: [id], onDelete: Restrict)
  referredBy     User         @relation(fields: [referredById], references: [id], onDelete: Restrict)
  reportDocument Document?    @relation(fields: [reportDocumentId], references: [id], onDelete: SetNull)

  /// The outstanding-referrals tray: what has been sent and not yet closed.
  @@index([tenantId, status, sentAt])
  @@index([tenantId, patientId, createdAt])
  @@index([tenantId, referredById, status])
  @@index([tenantId, priority, status])
}

// ---------------------------------------------------------------------------
// Stock
// ---------------------------------------------------------------------------

/// A thing the practice keeps on a shelf, as its own catalogue knows it.
///
/// There is no quantity column here, and its absence is the whole design. A
/// stored on-hand figure can be set, and once it can be set it will be, by a
/// well-meant repair of a number that looked wrong - leaving no trace of what
/// was wrong or who decided it. For a controlled substance that repair is
/// precisely what an audit exists to detect. On-hand is summed from
/// StockMovement every time it is asked for.
model StockItem {
  id                 String   @id @db.Uuid
  tenantId           String   @db.Uuid
  /// The practice's own catalogue code, and the natural key. Theirs rather than
  /// a terminology's: two suppliers' packages of the same drug are one line on
  /// the order sheet and two NDCs.
  sku                String
  name               String
  /// One of the nine values `StockUnit` allows in `@openrunic/inventory`. A
  /// String rather than an enum because three of them are UCUM codes, and this
  /// schema never bakes in a terminology. The value set is closed at the write
  /// door and proved against the package's own type in `apps/api/src/inventory`.
  unit               String
  rxnormCode         String?
  ndcCode            String?
  /// CDC CVX code, for a vaccine. Coded, so a plain string.
  cvxCode            String?
  /// Stock units in one supplier pack. Null means the pack is the unit. The
  /// conversion happens exactly once, at receipt: `packsToUnits` validates
  /// nothing, and applying it twice silently squares it.
  packSize           Decimal? @db.Decimal(18, 6)
  /// Flag the item when usable stock falls to or below this. Inclusive, matching
  /// `needsReorder`. Null means never flag, which is a different fact from zero.
  reorderLevel       Decimal? @db.Decimal(18, 6)
  /// A controlled substance. Drives one rule today - destroying one is recorded
  /// with a witness - and is the column a controlled register would be built on.
  controlled         Boolean  @default(false)
  /// DEA schedule as a string ("2".."5"); jurisdictional, so coded. Matches
  /// MedicationRequest.controlledSchedule.
  controlledSchedule String?
  /// A discontinued item stays, because its ledger does.
  active             Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  organisation Organisation @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  lots StockLot[]

  @@unique([tenantId, sku])
  /// Not a business key - `id` alone is already unique, so this adds no
  /// collision. It is the target of StockLot's tenant-carrying foreign key:
  /// referential-integrity checks run as the table owner and are filtered by no
  /// row-level-security policy, so the shape of the key is the only thing that
  /// can forbid a lot in one organisation pointing at another's item.
  @@unique([tenantId, id])
  /// The catalogue screen, filtered to what is still stocked.
  @@index([tenantId, active, name])
  /// Receiving: the clerk scans the carton, and the NDC is what they have.
  @@index([tenantId, ndcCode])
}

/// One carton, at one site, with the two clocks that decide when it stops being
/// usable.
///
/// The manufacturer's expiry is printed on the box. The beyond-use window that
/// starts when a multi-dose vial is first pierced is printed on nothing, usually
/// runs out first, and is the one a practice forgets - so both are columns, and
/// the package takes the earlier of the two. An absent `expiresOn` means the
/// item cannot expire, which is not the same fact as a date far in the future.
///
/// `facilityId` is required, and is one of the two scoping dimensions
/// `@openrunic/inventory` has no field for. Stock at another site is stock you
/// cannot physically reach, so every balance and every allocation filters on it
/// exactly as they filter on tenant.
model StockLot {
  id            String         @id @db.Uuid
  tenantId      String         @db.Uuid
  itemId        String         @db.Uuid
  facilityId    String         @db.Uuid
  /// The number printed on the carton, which is what a recall notice names. Not
  /// unique on its own: suppliers reuse numbers, and the same number at two
  /// sites is two boxes counted separately.
  lotNumber     String
  status        StockLotStatus @default(AVAILABLE)
  expiresOn     DateTime?      @db.Date
  /// When the vial was first pierced. Stamped by the server on the open
  /// transition and refused a second time, because opening twice would restart
  /// the clock this column exists to run down.
  openedOn      DateTime?      @db.Date
  /// Days the contents remain usable after opening. Meaningless without
  /// `openedOn`, and never validated by the package - a negative value silently
  /// produces a last-usable day earlier than the day the vial was opened - so
  /// the write door bounds it.
  beyondUseDays Int?
  manufacturer  String?
  /// The NDC of the package actually received, which can differ from the item's
  /// default when a generic arrives from a second supplier.
  ndcCode       String?
  /// The day it landed. Also FEFO's tie-break and the "not yet on the shelf"
  /// gate, so it is not nullable.
  receivedOn    DateTime       @db.Date
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  organisation Organisation @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  item         StockItem    @relation(fields: [tenantId, itemId], references: [tenantId, id], onDelete: Restrict)
  facility     Facility     @relation(fields: [facilityId], references: [id], onDelete: Restrict)

  movements     StockMovement[]
  statusChanges StockLotStatusChange[]

  /// Receiving the same carton number again is a second delivery into the same
  /// box, never a second box. The receipt path finds-or-creates on this key.
  @@unique([tenantId, itemId, facilityId, lotNumber])
  /// The target of StockMovement's foreign key. It constrains nothing on its own
  /// and exists so Postgres can prove a movement's denormalised itemId and
  /// facilityId are its own lot's.
  @@unique([tenantId, id, itemId, facilityId])
  /// The FEFO candidate fetch: every lot of one item at one site.
  @@index([tenantId, itemId, facilityId, receivedOn])
  /// The expiry tray, across a whole site.
  @@index([tenantId, facilityId, expiresOn])
  /// Somebody is holding a carton and does not know what it is.
  @@index([tenantId, lotNumber])
}

/// Every status a lot has held, and the day each took effect.
///
/// `StockLot.status` is one mutable value, so before this table every as-of
/// question was answered with today's answer. A lot retired on the 10th dropped
/// out of a query about the 1st, and a reconciliation of the 1st then came up
/// short against a shelf that had been correct - with the discrepancy pointing
/// at nothing, because the lot that explained it had been filtered out of the
/// answer. The direction is the dangerous one.
///
/// Append-only by intent: the spec that reads it declares an empty patch, so a
/// row cannot be edited into saying something else happened. A correction is a
/// new row, which is also what makes the sequence readable as a history rather
/// than as a current value with extra steps.
///
/// `effectiveOn` is a DATE and not a timestamp, because every other stock date
/// is a day and the package compares them lexicographically. Two changes on one
/// day are ordered by `lotSeq`, which is monotonic per lot: without it a recall
/// and the quarantine it followed could not be told apart on the day they both
/// happened.
model StockLotStatusChange {
  id          String         @id @db.Uuid
  tenantId    String         @db.Uuid
  lotId       String         @db.Uuid
  status      StockLotStatus
  /// The first day this status was in force, inclusive.
  effectiveOn DateTime       @db.Date
  /// Order within one lot, so two changes on the same day still have a sequence.
  lotSeq      Int
  /// Why. A recall notice number, a cold-chain excursion, an inspection outcome.
  reason      String?
  /// Who acted. Nullable, and the nullability is load bearing: rows written by
  /// the backfill describe lots whose transitions predate this table, and there
  /// is nobody to name for them. Inventing one would be a fact the record never
  /// stated.
  actorId     String?        @db.Uuid
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  organisation Organisation @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lot          StockLot     @relation(fields: [lotId], references: [id], onDelete: Cascade)

  /// One sequence number per lot, so the total order is enforced rather than
  /// assumed by whatever wrote last.
  @@unique([tenantId, lotId, lotSeq])
  /// The whole history of one lot, oldest first: what `toLot` fetches.
  @@index([tenantId, lotId, effectiveOn])
}

/// One thing that happened in the stockroom, and the ledger lines it produced.
///
/// A composite aggregate for the same reason a claim is one: a dispense of
/// thirty tablets drawn from two lots is two ledger lines and one act, and two
/// lines written by two requests are a half-recorded dispense nobody can tell
/// from a whole one. On an append-only table a half-recorded act cannot be
/// repaired, only apologised for. The lines are written in this row's own
/// transaction or not at all.
///
/// It also owns every fact belonging to the act rather than to the lot - the
/// patient, the prescription, the site, the supplier's packing slip, who posted
/// it and who witnessed it - so none of them can disagree between two lines of
/// one dispense.
model StockPosting {
  id             String           @id @db.Uuid
  tenantId       String           @db.Uuid
  kind           StockPostingKind
  facilityId     String           @db.Uuid
  /// Null on a receipt and on a count. Present on anything that left the shelf
  /// for somebody.
  patientId      String?          @db.Uuid
  encounterId    String?          @db.Uuid
  /// The prescription this fill was against, when there was one. The clinical
  /// record stays where it is; this is the stock side of it.
  prescriptionId String?          @db.Uuid
  /// The immunisation this dose was drawn for. Optional in both directions on
  /// purpose: a vaccine can be recorded clinically before the stockroom catches
  /// up, and refusing the clinical record because the ledger disagreed would be
  /// the wrong failure in the wrong direction.
  immunizationId String?          @db.Uuid
  occurredOn     DateTime         @db.Date
  postedById     String           @db.Uuid
  /// The second person on the destruction of a controlled substance. Recorded
  /// rather than derived, because who watched is a fact about the event.
  witnessedById  String?          @db.Uuid
  /// The supplier's packing slip, the count sheet, the invoice. Free text,
  /// because it is whatever the piece of paper says.
  reference      String?
  note           String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organisation Organisation @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  facility     Facility     @relation(fields: [facilityId], references: [id], onDelete: Restrict)
  patient      Patient?     @relation(fields: [patientId], references: [id], onDelete: Restrict)
  encounter    Encounter?   @relation(fields: [encounterId], references: [id], onDelete: Restrict)

  movements StockMovement[]

  /// The stockroom day book.
  @@index([tenantId, facilityId, occurredOn])
  /// What a patient was given, from the stock side.
  @@index([tenantId, patientId, occurredOn])
  /// The receipt log, the wastage report, the count history.
  @@index([tenantId, kind, occurredOn])
}

/// One append-only ledger line. The only place a stock quantity lives.
///
/// A mistake is corrected by a compensating row carrying `correctsMovementId`
/// and a reason; both rows stay, the balance moves and the history does not.
/// That is not left as a convention: the migration creating this table revokes
/// UPDATE and DELETE from the application role, exactly as the row-level
/// security migration already does for AuditEvent.
///
/// Six indexes on a write-heavy table is more than this schema usually carries,
/// and it is affordable because the table is append-only: index maintenance is
/// insert-only, with no update churn and no bloat.
model StockMovement {
  id                 String            @id @db.Uuid
  tenantId           String            @db.Uuid
  /// The business event this line belongs to. Restrict, because a line that
  /// outlived its posting would be stock nobody can account for.
  postingId          String            @db.Uuid
  lotId              String            @db.Uuid
  /// Denormalised from the lot, and it has to be: `balancesByLot` filters
  /// movements on `itemId` and this layer does no joins. The composite foreign
  /// key below keeps the copy true. The package cross-checks nothing here and
  /// its failure is silent - a movement filed under the wrong item vanishes from
  /// `balancesByLot`, and `allocate` then reports a shortfall against a full
  /// shelf.
  itemId             String            @db.Uuid
  /// The same argument and the same key: the ledger has to be readable per site
  /// without a join.
  facilityId         String            @db.Uuid
  kind               StockMovementKind
  /// Always positive; direction is the kind's job. Scale 6 is exactly the grid
  /// `toStockPrecision` rounds to, so a value the package accepted cannot be
  /// re-rounded on the way into the column.
  quantity           Decimal           @db.Decimal(18, 6)
  /// When it happened, not when it was typed. `createdAt` is when it was typed,
  /// and the gap between the two is what a back-dated entry is made of - the
  /// package has no field for it at all.
  occurredOn         DateTime          @db.Date
  /// Who did it, from the verified principal and never from a request body. A
  /// provenance stamp, so no relation.
  actorId            String            @db.Uuid
  /// Required by `movementProblems` for WASTE, both count variances, and any
  /// correction. The package refuses the row and Zod names the field to the
  /// client, so the same rule is stated to two different audiences.
  reason             String?
  /// The line this one reverses. Nullable, so it must never appear in a spec's
  /// `uniqueBy`: a Prisma probe on an absent value matches every row rather than
  /// none, and would turn every create into a 409.
  correctsMovementId String?           @db.Uuid
  /// This row's position in its lot's ledger, from 1. Two jobs at once: the
  /// total order of a lot's history, and the concurrency guard. An allocation is
  /// computed from a snapshot, and the sequence derived from that snapshot is an
  /// assertion that nothing has touched the lot since it looked.
  lotSeq             Int
  createdAt          DateTime          @default(now())
  /// Carried because every model carries it. It never changes: the application
  /// role holds no UPDATE privilege on this table.
  updatedAt          DateTime          @updatedAt

  organisation Organisation    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  posting      StockPosting    @relation(fields: [postingId], references: [id], onDelete: Restrict)
  /// Four columns, and every one is load-bearing. `tenantId` because
  /// referential-integrity checks run as the table owner and no policy filters
  /// them. `itemId` and `facilityId` because the package cannot check them and
  /// their disagreement is silent. `onUpdate: NoAction` because a cascading
  /// update runs with the owner's privileges and would rewrite ledger rows
  /// straight past the revoked UPDATE.
  lot          StockLot        @relation(fields: [tenantId, lotId, itemId, facilityId], references: [tenantId, id, itemId, facilityId], onDelete: Restrict, onUpdate: NoAction)
  corrects     StockMovement?  @relation("StockMovementCorrection", fields: [correctsMovementId], references: [id], onDelete: Restrict)
  /// Declared as a list rather than a one-to-one because Prisma refuses the
  /// one-to-one form here - it wants a single-column `@unique` on the defining
  /// side, and the rule is tenant-scoped. The at-most-one guarantee is the
  /// unique index below, so this array holds zero or one row, always.
  corrections  StockMovement[] @relation("StockMovementCorrection")

  /// The concurrency guard, and the ledger's order. Also makes the ledger
  /// provably gapless per lot, so "did we read every movement from inception"
  /// is answerable as max(lotSeq) == count.
  @@unique([tenantId, lotId, lotSeq])
  /// A movement is corrected at most once. Postgres treats NULLs as distinct in
  /// a unique index, so this needs no partial index and binds only corrections.
  @@unique([tenantId, correctsMovementId])
  /// The hot path: every movement for one item at one site from inception, which
  /// is what `itemBalance`, `balancesByLot` and `allocate` all need.
  @@index([tenantId, itemId, facilityId, occurredOn])
  /// One posting's own lines. Prisma does not index foreign keys on Postgres.
  @@index([tenantId, postingId])
  /// The wastage report and the receipt log.
  @@index([tenantId, kind, occurredOn])
  /// Entered-versus-occurred, for finding back-dated entries.
  @@index([tenantId, createdAt])
  /// A diversion investigation starts from a person, not from a lot.
  @@index([tenantId, actorId, createdAt])
}

/// An imaging study: the record that pictures exist, and where to find them.
///
/// openrunic is not a PACS and this table is the boundary that says so. IT
/// HOLDS NO PIXEL DATA and has no column that could. A DICOM study is gigabytes
/// of images with their own storage, their own retention rules and their own
/// viewer; an EMR's job is to know a study happened, tie it to the order that
/// asked for it and the chart it belongs to, and be able to point a viewer at
/// it. Storing the images here would duplicate a system that already exists and
/// do it worse.
///
/// "accessionNumber" is the identifier that makes this work at all. It is what
/// the order, the modality worklist and the PACS all carry, so it is how a
/// study coming back from a scanner is reconciled with the order that asked for
/// it. A study that arrives without one cannot be attached to anything and has
/// to be matched by a human.
model ImagingStudy {
  id                 String             @id @db.Uuid
  tenantId           String             @db.Uuid
  patientId          String             @db.Uuid
  encounterId        String?            @db.Uuid
  /// The order that asked for it, when there was one. Null for an outside study.
  serviceRequestId   String?            @db.Uuid
  /// The radiologist's report, once it exists.
  diagnosticReportId String?            @db.Uuid
  /// DICOM Study Instance UID (0020,000D). Globally unique by the standard.
  studyInstanceUid   String
  /// Shared by the order, the worklist and the PACS. How a study is reconciled.
  accessionNumber    String?
  /// DICOM modality codes present in the study: CT, MR, US, CR, DX, and so on.
  modalities         String[]
  description        String?
  status             ImagingStudyStatus @default(AVAILABLE)
  startedAt          DateTime
  numberOfSeries     Int                @default(0)
  numberOfInstances  Int                @default(0)
  /// Where a viewer retrieves the study, normally a DICOMweb WADO-RS study URL.
  /// Null when the deployment's viewer resolves studies by UID on its own.
  retrieveUrl        String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  organisation Organisation      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  patient      Patient           @relation(fields: [patientId], references: [id], onDelete: Restrict)
  encounter    Encounter?        @relation(fields: [encounterId], references: [id], onDelete: Restrict)
  order        ServiceRequest?   @relation(fields: [serviceRequestId], references: [id], onDelete: Restrict)
  report       DiagnosticReport? @relation(fields: [diagnosticReportId], references: [id], onDelete: Restrict)

  /// A study instance UID identifies one study. Two rows claiming the same one
  /// is a study with two records that can disagree about which order it answers.
  @@unique([tenantId, studyInstanceUid])
  @@index([tenantId, patientId, startedAt])
  @@index([tenantId, accessionNumber])
}

enum ImagingStudyStatus {
  /// Ordered and expected, but nothing has arrived from the modality yet.
  REGISTERED
  AVAILABLE
  /// Withdrawn: the study should not be in this chart. Kept, not deleted, so
  /// the report that cited it does not point at nothing.
  ENTERED_IN_ERROR
}

/// A named set of codes, as the deployment defined it.
///
/// Quality measures name the value sets they read by canonical URL and this is
/// where a deployment says what is in one. The rows are definitions, not
/// expansions: the codes themselves live in "TerminologyCode", and storing a
/// resolved list here would go stale the moment a code system release was
/// loaded and would give one value set two answers.
///
/// NOTHING SHIPS IN THIS TABLE. The measure specifications are public; the code
/// lists behind them are licensed content this project does not redistribute.
/// A deployment obtains them under whatever licence applies to it and loads them
/// here, exactly as it does code systems - see packages/terminology.
model ValueSet {
  id          String   @id @db.Uuid
  tenantId    String   @db.Uuid
  /// Canonical identifier. What a measure names, and what a caller passes.
  url         String
  name        String?
  description String?
  /// Include and exclude rules, in the shape `packages/terminology` parses.
  /// Json because the shape is the terminology package's to define, and a
  /// column per rule field would have to migrate every time it gained one.
  definition  Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  organisation Organisation @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, url])
  @@index([tenantId, url])
}

/// A telehealth visit: one video room, for one appointment.
///
/// Deliberately a table of its own rather than columns on Appointment. Most
/// appointments are in person and would carry six null columns forever, and the
/// vendor's identifiers are not part of the scheduling aggregate: an appointment
/// is a commitment between people, and a room is a thing a vendor made.
///
/// NO JOIN TOKEN IS STORED HERE, and there is no column for one. A token admits
/// the bearer to a consultation. Persisting one turns every future read of this
/// table, every backup and every support export into a way into a patient's
/// appointment. Tokens are issued on demand, handed to the caller once, and
/// never written down.
model TelehealthVisit {
  id              String                @id @db.Uuid
  tenantId        String                @db.Uuid
  /// One room per appointment. A second room for the same visit is two waiting
  /// rooms, and half the participants end up in the wrong one.
  appointmentId   String                @unique @db.Uuid
  /// The vendor whose adapter made this room. Recorded because a room outlives a
  /// configuration change, and afterwards nobody can tell which vendor to ask.
  vendorId        String
  /// The vendor's own room identifier. Opaque to this system by design.
  roomRef         String
  joinUrl         String
  status          TelehealthVisitStatus @default(OPEN)
  scheduledStart  DateTime
  /// After this instant the vendor refuses every token, including issued ones.
  expiresAt       DateTime
  endedAt         DateTime?
  endedReason     String?
  /// Wall-clock length the vendor reported, which billing uses as one input to
  /// visit duration. Null until the visit ends.
  durationSeconds Int?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  organisation Organisation @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  appointment  Appointment  @relation(fields: [appointmentId], references: [id], onDelete: Restrict)

  @@index([tenantId, status, scheduledStart])
}

enum TelehealthVisitStatus {
  OPEN
  ENDED
  EXPIRED
}
