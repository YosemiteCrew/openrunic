{
  "name": "@openrunic/ops",
  "version": "0.1.0",
  "description": "Self-host operations for openrunic: first-run install, backup and restore, upgrades, and the migration-safety linter.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "openrunic-ops": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc --build tsconfig.json",
    "lint": "eslint .",
    "type-check": "tsc -p tsconfig.typecheck.json",
    "test": "vitest run",
    "ops": "tsx src/cli.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.1",
    "@vitest/coverage-v8": "^4.1.0",
    "eslint": "^9.39.5",
    "tsx": "^4.23.11",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.66.0",
    "vitest": "^4.1.0"
  }
}
