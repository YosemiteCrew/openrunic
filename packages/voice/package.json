{
  "name": "@openrunic/voice",
  "version": "0.2.0",
  "description": "The speech boundary for the Openrunic EMR: the readback port, the on-device adapter behind it, and the rules that decide what may be heard.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc --build tsconfig.json",
    "lint": "eslint .",
    "type-check": "tsc -p tsconfig.typecheck.json",
    "test": "vitest run"
  },
  "peerDependencies": {
    "react": "^19"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.18",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^9.39.5",
    "jsdom": "^30.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.66.0",
    "vitest": "^4.1.11"
  }
}
